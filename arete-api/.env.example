# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el .env a git (ya está en .gitignore)

# Conexión DIRECTA (para migraciones / desarrollo local)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Conexión via POOLER - Transaction mode (recomendado para producción/serverless)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
